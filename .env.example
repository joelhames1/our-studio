# Copy to .env.local for running on a laptop. On Vercel, set these in
# Project Settings > Environment Variables instead. See docs/SETUP.md.

# Sign-in links: at least 24 random characters each, e.g. `openssl rand -hex 24`.
# Leave empty on a laptop (with Supabase empty too) to get the "I'm Erin / I'm Joel" picker.
ERIN_LINK_TOKEN=
JOEL_LINK_TOKEN=
# Change to sign everyone out everywhere.
# SESSION_VERSION=1

# Storage (leave empty on a laptop to save into ./.data)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI (all optional)
ANTHROPIC_API_KEY=
FAL_KEY=
OPENAI_API_KEY=

# Knobs (optional)
MONTHLY_BUDGET_USD=25
IMAGE_QUALITY=medium
# ANTHROPIC_MODEL=claude-opus-5-5
# FAL_IMAGE_MODEL=fal-ai/gpt-image-1.5
# IMAGE_PROVIDER=fal
